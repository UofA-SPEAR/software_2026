<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="plex_arm_3">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import plex_arm_3 urdf file -->
    <xacro:include filename="$(find plex_arm_3)/urdf/plex_arm_3.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="plex_arm_3.ros2_control.xacro" />


    <xacro:plex_arm_3_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
