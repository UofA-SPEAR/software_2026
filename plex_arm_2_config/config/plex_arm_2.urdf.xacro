<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="plex_arm_2">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import plex_arm_2 urdf file -->
    <xacro:include filename="$(find plex_arm_2)/urdf/plex_arm_2.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="plex_arm_2.ros2_control.xacro" />


    <xacro:plex_arm_2_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
